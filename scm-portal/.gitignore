# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# local command output (typecheck, lint, test runs)
*.out

# env files — keep example templates committed
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!env.config.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# turbo
.turbo

# IDE
.idea/
.vscode/
